{
  "name": "hms-next-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "vitest run --config vitest.integration.config.mts",
    "auth:verify": "playwright test --config playwright.auth.config.ts",
    "db:advisors": "tsx scripts/db-advisors.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "seed": "tsx scripts/seed.ts",
    "ingestion:verify": "playwright test --config playwright.ingestion.config.ts",
    "summaries:recompute": "tsx scripts/recompute.ts",
    "summaries:verify": "tsx scripts/verify-summaries.ts",
    "cron:setup": "tsx scripts/setup-cron.ts",
    "alerts:verify": "playwright test --config playwright.alerts.config.ts"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.116.0",
    "@zip.js/zip.js": "2.11.4",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "6.0.0",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}

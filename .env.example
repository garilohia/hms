# Required: existing Supabase project in ap-south-1 (Mumbai).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Server-only Postgres connection, with URL-encoded password; never expose publicly.
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required when scheduling jobs; generate a random secret, also held by the scheduler.
CRON_SECRET=
# Secret salt for consent IP hashes.
CONSENT_IP_SALT=
# Optional: console email transport when no key is configured.
RESEND_API_KEY=
EMAIL_FROM=
# Reserved: server push is not implemented; these fields alone do not enable delivery.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Direct wearable connections. Keep secrets server-only.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
INTEGRATION_TOKEN_KEY=
